<Window x:Class="Notepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Блокнот" Height="450" Width="700"
        Closing="Window_Closing">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="Открыть" Margin="5" Width="80" Click="OpenButton_Click"/>
            <Button Content="Сохранить" Margin="5" Width="80" Click="SaveButton_Click"/>
        </StackPanel>
        <TextBox x:Name="EditorTextBox" AcceptsReturn="True"/>
    </DockPanel>
</Window>

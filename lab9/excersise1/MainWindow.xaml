<Window x:Class="excersise1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:excersise1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBox x:Name="myTextBox" Height="30" FontSize="14"/>
            <TextBlock x:Name="myTextBlock" FontSize="14" Margin=" 0,5,0,0"
                       Text="{Binding ElementName=myTextBox, Path=Text, Mode=Default}"/>
        </StackPanel>
    </Grid>
</Window>

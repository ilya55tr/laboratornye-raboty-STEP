<Window x:Class="SelfWork.ClientInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SelfWork"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="Информация о клиенте" 
        Width="350"
        SizeToContent="Height">
    <StackPanel Margin="15">
        <TextBlock Text="Клиент Зарегистрирован" 
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <TextBlock>
            <Run Text="ФИО: " FontWeight="Bold" />
            <Run Text="{Binding FullName, Mode=OneWay}" />
        </TextBlock>
        <TextBlock>
            <Run Text="Серия паспорта: " FontWeight="Bold" />
            <Run Text="{Binding PassportSeries, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Margin="0,0,0,15">
            <Run Text="Номер паспорта: " FontWeight="Bold" />
            <Run Text="{Binding PassportNumber, Mode=OneWay}" />
        </TextBlock>

        <Button Content="OK" Width="80" Height="25"
                HorizontalAlignment="Right" IsCancel="True" />
    </StackPanel>
</Window>

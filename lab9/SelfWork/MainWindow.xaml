<Window x:Class="SelfWork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SelfWork"
        mc:Ignorable="d"
        Title="Регистрация клиента" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="15">
        <TextBlock Text="ФИО:"/>
        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                 Height="25"
                 Margin="0,0,0,10"/>

        <TextBlock Text="Серия паспорта:"/>
        <TextBox Text="{Binding PassportSeries, UpdateSourceTrigger=PropertyChanged}"
                 Height="25"
                 Margin="0,0,0,10"
                 MaxLength="4"/>
                 
        <TextBlock Text="Номер паспорта:"/>
        <TextBox Text="{Binding PassportNumber, UpdateSourceTrigger=PropertyChanged}"
                 Height="25"
                 Margin="0,0,0,10"
                 MaxLength="6"/>

        <Button Content="Зарегистрировать" Height="30" Click="Register_Click"/>

    </StackPanel>
</Window>
